model FormationEnrollment {
  id       String          @id @default(cuid())
  courseId String
  course   FormationCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  memberId String
  member   Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)

  status              FormationEnrollmentStatus @default(ENROLLED)
  completedAt         DateTime?
  expiresAt           DateTime? // completedAt + validityMonths
  certificateIssuedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, memberId])
  @@index([courseId])
  @@index([memberId])
  @@index([status])
  @@map("formation_enrollments")
}

// ============================================
// FASE 4 — RESERVA DE ESPAÇOS
// ============================================

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Room {
  id          String       @id @default(cuid())
  communityId String
  community   Community    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name        String
  capacity    Int?
  resources   String? // projetor, som, etc. (texto livre)
  status      EntityStatus @default(ACTIVE)

  reservations RoomReservation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([communityId])
  @@index([deletedAt])
  @@map("rooms")
}

model RoomReservation {
  id     String @id @default(cuid())
  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  title  String

  startTime DateTime
  endTime   DateTime

  requesterUserId     String?
  communityPastoralId String?
  eventId             String?

  status ReservationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId])
  @@index([startTime])
  @@index([status])
  @@map("room_reservations")
}

// ============================================
// FASE 4 — DÍZIMO (integra com FinancialTransaction)
// ============================================

enum TitherStatus {
  ACTIVE
  INACTIVE
}

model Tither {
  id                 String       @id @default(cuid())
  memberId           String       @unique
  member             Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  registrationNumber String? // nº de registro / envelope
  joinedAt           DateTime     @default(now())
  status             TitherStatus @default(ACTIVE)

  contributions TitheContribution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("tithers")
}

model TitheContribution {
  id       String @id @default(cuid())
  titherId String
  tither   Tither @relation(fields: [titherId], references: [id], onDelete: Cascade)

  amount         Float
  date           DateTime
  referenceMonth String // "2026-07"
  method         String // dinheiro | PIX | débito
  receiptNumber  String?

  // Liga ao financeiro (categoria "Dízimo")
  financialTransactionId String?

  // Contribuição originada de um Pix pelo app (Dízimo online)
  intent TitheIntent?

  createdAt DateTime @default(now())

  @@index([titherId])
  @@index([referenceMonth])
  @@map("tithe_contributions")
}

// ============================================
// DÍZIMO ONLINE — intenção de contribuição pelo app (Pix da paróquia)
// ============================================

enum TitheIntentKind {
  TITHE // dízimo mensal
  OFFERING // oferta avulsa
}

enum TitheIntentStatus {
  CREATED // Pix gerado, ainda não declarado
  DECLARED // fiel marcou "já fiz o Pix" — aguarda conferência da tesouraria
  CONFIRMED // tesouraria conferiu: virou contribuição + lançamento financeiro
  CANCELLED // cancelado pelo fiel ou não localizado pela tesouraria
}

enum TitheIntentMethod {
  PIX_STATIC // BR Code com a chave da paróquia (Fase 1)
  GATEWAY // provedor de pagamento com webhook (Fase 2)
  MANUAL // registrado presencialmente pela tesouraria/agente (D4.2): envelope, dinheiro, maquininha…
}

model TitheIntent {
  id          String            @id @default(cuid())
  memberId    String
  member      Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  parishId    String
  parish      Parish            @relation(fields: [parishId], references: [id], onDelete: Cascade)
  communityId String?
  amount      Float
  // Mês de referência "2026-08" (dízimo) — ofertas usam o mês do pagamento
  referenceMonth String
  kind           TitheIntentKind   @default(TITHE)
  method         TitheIntentMethod @default(PIX_STATIC)
  status         TitheIntentStatus @default(CREATED)
  // Identificador do Pix (campo txid do BR Code, até 25 alfanuméricos)
  txid   String  @unique
  brCode String?
  // Meio escolhido pelo fiel no provedor (D3.4): PIX | CARD | BOLETO
  paymentMethod  String    @default("PIX")
  // Página de pagamento do provedor (cartão/boleto), PDF do boleto e linha digitável
  paymentUrl     String?
  boletoUrl      String?
  boletoLine     String?
  // Provedor (D3): referência da cobrança, status bruto, validade do QR, taxa/valor cobrado
  providerRef    String?   @unique
  providerStatus String?
  qrExpiresAt    DateTime?
  feeAmount      Float     @default(0)
  chargedAmount  Float?
  scheduleId     String?
  schedule       TitheSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  // Campanha/fundo (D4.1): oferta com finalidade
  campaignId     String?
  campaign       TitheCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  // Observação da tesouraria (ex.: motivo de "não localizado")
  note String?
  // Valor que de fato caiu no extrato (pode diferir do gerado)
  amountPaid Float?
  // Oferta anônima: nome não aparece à tesouraria nem no lançamento
  anonymous Boolean @default(false)
  // Contestação do fiel após "não localizado"
  contestNote String?
  contestedAt DateTime?

  declaredAt        DateTime?
  confirmedAt       DateTime?
  confirmedByUserId String?
  contributionId    String?            @unique
  contribution      TitheContribution? @relation(fields: [contributionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId, createdAt])
  @@index([parishId, status])
  @@index([communityId, status])
  @@map("tithe_intents")
}

// ============================================
// FASE 4 — PREPARAÇÃO DE SACRAMENTOS
// ============================================

enum SacramentProcessStatus {
  REQUESTED
  DOCUMENTS
  COURSE
  SCHEDULED
  CELEBRATED
  CANCELLED
}

model SacramentProcess {
  id     String                 @id @default(cuid())
  type   SacramentType
  status SacramentProcessStatus @default(REQUESTED)

  // Membro principal (batizando / noivo). Demais envolvidos (pais, padrinhos)
  // ficam em `involved` (Json) para flexibilidade.
  memberId    String
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  involved           Json? // [{ role, name, memberId? }]
  documentsChecklist Json? // [{ name, done }]
  courseEventId      String? // curso (Event FORMATION)
  scheduledDate      DateTime?
  celebrant          String?
  notes              String?

  // Resultado: sacramento gerado na celebração + numeração da certidão
  sacramentId String?
  book        String?
  page        String?
  term        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([memberId])
  @@index([communityId])
  @@index([status])
  @@index([deletedAt])
  @@map("sacrament_processes")
}

// ============================================
// FASE 4 — VISITAÇÃO / ENFERMOS (privacidade rígida)
// ============================================

enum VisitReason {
  SICK // enfermo
  ELDERLY // idoso
  BEREAVEMENT // luto
  OTHER
}

enum VisitRequestStatus {
  OPEN
  SCHEDULED
  DONE
  CANCELLED
}

model VisitRequest {
  id                  String    @id @default(cuid())
  communityId         String
  community           Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  // Pastoral da visitação responsável (restringe o acesso às anotações)
  communityPastoralId String?

  // Pessoa a visitar: um membro OU dados avulsos
  memberId     String?
  personName   String?
  address      String?
  contactPhone String?

  reason          VisitReason
  // Consentimento explícito do visitado/família (dado sensível de saúde)
  consentGiven    Boolean            @default(false)
  requesterUserId String?
  status          VisitRequestStatus @default(OPEN)

  visits Visit[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([communityId])
  @@index([communityPastoralId])
  @@index([status])
  @@index([deletedAt])
  @@map("visit_requests")
}

model Visit {
  id               String       @id @default(cuid())
  visitRequestId   String
  visitRequest     VisitRequest @relation(fields: [visitRequestId], references: [id], onDelete: Cascade)
  date             DateTime
  // Dupla visitadora (ids de members, csv) — simplificado
  visitorMemberIds String?
  // Anotações pastorais: SENSÍVEL. Acesso apenas coordenador da pastoral + visitadores.
  notes            String?
  createdByUserId  String?

  createdAt DateTime @default(now())

  @@index([visitRequestId])
  @@map("visits")
}

// ============================================
// FASE 4 — TROCA DE ESCALA (SWAP)
// ============================================

model AssignmentSwapRequest {
  id           String             @id @default(cuid())
  assignmentId String
  assignment   ScheduleAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  requesterId String // member solicitante
  targetId    String? // member convidado (null = aberto à pastoral)
  status      SwapStatus @default(PENDING)

  requiresApproval Boolean @default(false)
  approvedByUserId String?
  message          String?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([assignmentId])
  @@index([status])
  @@map("assignment_swap_requests")
}

// ============================================
// SANTOS — catálogo global + padroeiros
// (mesmo padrão das pastorais: cadastro global, vínculo por nível)
// ============================================

model Saint {
  id         String  @id @default(cuid())
  name       String  @unique // Ex.: "São José", "Nossa Senhora Aparecida"
  feastMonth Int? // mês da festa litúrgica (1-12)
  feastDay   Int? // dia da festa litúrgica (1-31)
  patronOf   String? // padroeiro(a) de quê: "trabalhadores", "Brasil"...
  biography  String?
  imageUrl   String?

  status EntityStatus @default(ACTIVE)

  patronages SaintPatronage[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  @@index([feastMonth, feastDay])
  @@index([deletedAt])
  @@map("saints")
}

// Vínculo de padroeiro: exatamente UM nível (diocese OU paróquia OU comunidade)
model SaintPatronage {
  id      String @id @default(cuid())
  saintId String
  saint   Saint  @relation(fields: [saintId], references: [id], onDelete: Cascade)

  dioceseId   String?
  diocese     Diocese?   @relation(fields: [dioceseId], references: [id], onDelete: Cascade)
  parishId    String?
  parish      Parish?    @relation(fields: [parishId], references: [id], onDelete: Cascade)
  communityId String?
  community   Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)

  isPrimary Boolean @default(true) // padroeiro principal vs co-padroeiro
  notes     String?

  createdAt DateTime @default(now())

  @@unique([saintId, dioceseId])
  @@unique([saintId, parishId])
  @@unique([saintId, communityId])
  @@index([dioceseId])
  @@index([parishId])
  @@index([communityId])
  @@map("saint_patronages")
}

// ============================================
// PALAVRA DO PASTOR — mensagens/vídeos do clero
// (Bispo/Pároco/Diácono → pastoral, membro ou comunidade inteira)
// ============================================

enum ClergyMessageAudience {
  DIOCESE // toda a diocese (bispo)
  PARISH // toda a paróquia (pároco)
  COMMUNITY // toda a comunidade
  PASTORAL // uma pastoral específica
  MEMBER // um membro específico
}

model ClergyMessage {
  id       String  @id @default(cuid())
  title    String
  body     String? // texto da mensagem
  videoUrl String? // link de vídeo (YouTube, Vimeo...)

  senderUserId      String
  sender            User         @relation("ClergyMessagesSent", fields: [senderUserId], references: [id], onDelete: Cascade)
  senderTitle       String? // assinatura pastoral: "Pe. João — Pároco", "Dom Carlos", "Diác. José"
  // Cargo do remetente no momento da publicação (denormalizado p/ rótulo estável)
  senderClergyTitle ClergyTitle?

  audience ClergyMessageAudience

  // Alvo conforme a audiência (exatamente um preenchido)
  dioceseId           String?
  diocese             Diocese?           @relation(fields: [dioceseId], references: [id], onDelete: Cascade)
  parishId            String?
  parish              Parish?            @relation(fields: [parishId], references: [id], onDelete: Cascade)
  communityId         String?
  community           Community?         @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityPastoralId String?
  communityPastoral   CommunityPastoral? @relation(fields: [communityPastoralId], references: [id], onDelete: Cascade)
  memberId            String?
  member              Member?            @relation(fields: [memberId], references: [id], onDelete: Cascade)

  publishedAt DateTime @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  @@index([audience, publishedAt])
  @@index([dioceseId])
  @@index([parishId])
  @@index([communityId])
  @@index([communityPastoralId])
  @@index([memberId])
  @@index([deletedAt])
  @@map("clergy_messages")
}

// ============================================
// ONDA 4 — "Quero participar" (pastorais) e conversa família ↔ equipe (catequese)
// ============================================

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Pedido de ingresso do fiel numa pastoral da comunidade; a coordenação aprova/recusa
model PastoralJoinRequest {
  id                  String            @id @default(cuid())
  communityPastoralId String
  communityPastoral   CommunityPastoral @relation(fields: [communityPastoralId], references: [id], onDelete: Cascade)
  memberId            String
  member              Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status              JoinRequestStatus @default(PENDING)
  // Recado do fiel ao pedir (opcional) e motivo da recusa (opcional)
  message         String?
  rejectionReason String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Um pedido por (pastoral, membro): reenviar reabre o mesmo registro
  @@unique([communityPastoralId, memberId])
  @@index([communityPastoralId, status])
  @@index([memberId])
  @@map("pastoral_join_requests")
}

// Conversa por MATRÍCULA entre a família (responsáveis) e a equipe da turma.
// Só esses dois lados leem; não há grupo aberto. Retenção: enquanto a matrícula existir.
model CatechesisMessage {
  id           String               @id @default(cuid())
  enrollmentId String
  enrollment   CatechesisEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  authorUserId String
  author       User                 @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  // true = escrita pela equipe (catequista/coordenação); false = pela família
  fromTeam Boolean
  body     String
  // Lida pelo OUTRO lado (equipe lê a da família e vice-versa)
  readAt    DateTime?
  // Entregue = notificação criada para o outro lado (null: ninguém para receber
  // ou o push falhou — a mensagem segue visível na conversa)
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([enrollmentId, createdAt])
  @@index([enrollmentId, fromTeam, readAt])
  @@map("catechesis_messages")
}

// ============================================
// DÍZIMO D3 — provedor de pagamento, recorrência e eventos de webhook
// ============================================

// Cliente do membro no provedor (Asaas cus_…) — um por provedor
model MemberProviderCustomer {
  id                 String @id @default(cuid())
  memberId           String
  member             Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  provider           String // ASAAS | MERCADOPAGO
  // Cliente é por conta do provedor: paróquia + ambiente (sandbox/produção)
  providerEnv        String @default("sandbox")
  parishId           String @default("")
  providerCustomerId String
  createdAt          DateTime @default(now())

  @@unique([memberId, provider, providerEnv, parishId])
  @@map("member_provider_customers")
}

enum TitheScheduleMode {
  PIX_AUTOMATIC // Pix Automático (débito autorizado no banco do fiel)
  PIX_SUBSCRIPTION // assinatura clássica: um Pix por mês para o fiel pagar
}

enum TitheScheduleStatus {
  PENDING_AUTHORIZATION // aguardando o fiel autorizar no banco (Pix Automático)
  ACTIVE
  PAUSED
  CANCELLED
  FAILED
}

// Dízimo recorrente do fiel
model TitheSchedule {
  id       String   @id @default(cuid())
  memberId String
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  parishId String
  parish   Parish   @relation(fields: [parishId], references: [id], onDelete: Cascade)
  amount     Float
  dayOfMonth Int
  mode       TitheScheduleMode
  status     TitheScheduleStatus @default(PENDING_AUTHORIZATION)
  provider   String // ASAAS | MERCADOPAGO
  // Referências no provedor: assinatura e/ou autorização de Pix Automático
  providerSubscriptionRef  String?
  providerAuthorizationRef String?
  // QR de autorização (primeiro pagamento) enquanto pendente
  authorizationPayload  String?
  authorizationExpires  DateTime?
  nextDueDate DateTime?
  lastError   String?
  cancelledAt DateTime?
  intents     TitheIntent[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([memberId, status])
  @@index([parishId, status])
  @@index([providerSubscriptionRef])
  @@index([providerAuthorizationRef])
  // + índice único parcial (SQL da migração tithe_d3_fixes): um dízimo
  // automático aberto (PENDING_AUTHORIZATION/ACTIVE/PAUSED) por membro
  @@map("tithe_schedules")
}

// Eventos de webhook recebidos (idempotência + rastreabilidade)
model PaymentWebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  parishId    String
  parish      Parish   @relation(fields: [parishId], references: [id], onDelete: Cascade)
  eventName   String
  payload     Json
  receivedAt  DateTime @default(now())
  processedAt DateTime?
  error       String?
  attempts    Int       @default(0)

  @@unique([provider, eventId])
  @@index([parishId, receivedAt])
  @@map("payment_webhook_events")
}

// ===== Fundos e campanhas (Dízimo D4.1) =====
enum TitheCampaignKind {
  CAMPAIGN // coleta com meta e prazo (ex.: reforma do telhado)
  FUND // finalidade permanente (ex.: caridade, obras)
}

enum TitheCampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum TitheCampaignPledgeStatus {
  OPEN
  CANCELLED
}

model TitheCampaign {
  id          String              @id @default(cuid())
  parishId    String
  parish      Parish              @relation(fields: [parishId], references: [id], onDelete: Cascade)
  // null = paróquia inteira; senão só a comunidade vê e contribui
  communityId String?
  community   Community?          @relation(fields: [communityId], references: [id], onDelete: SetNull)
  kind        TitheCampaignKind   @default(CAMPAIGN)
  status      TitheCampaignStatus @default(DRAFT)
  // Código curto (txid do QR próprio: CP + código)
  code        String              @unique
  name        String
  description String?
  goalAmount  Float?
  startsAt    DateTime?
  endsAt      DateTime?
  allowAnonymous   Boolean @default(true)
  suggestedAmounts Json?
  createdByUserId  String?
  closedAt         DateTime?
  intents      TitheIntent[]
  transactions FinancialTransaction[]
  pledges      TitheCampaignPledge[]
  guestGifts   TitheGuestGift[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parishId, status])
  @@index([communityId, status])
  @@map("tithe_campaigns")
}

// Ação pastoral registrada pela tesouraria/pastoral do dízimo com um dizimista (D4.4)
enum TitheRetentionActionType {
  THANKS // agradecimento/acolhida
  MESSAGE // mensagem (WhatsApp, e-mail, bilhete)
  CALL // ligação
  VISIT // visita pastoral
  NOTE // anotação interna
}

model TitheRetentionAction {
  id        String                   @id @default(cuid())
  memberId  String
  member    Member                   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  userId    String?
  userName  String?
  type      TitheRetentionActionType
  note      String?
  createdAt DateTime                 @default(now())

  @@index([memberId, createdAt])
  @@map("tithe_retention_actions")
}

// Oferta de visitante (D4.6): sem cadastro no Parish, pela página pública; recibo por e-mail
enum TitheGuestGiftStatus {
  CREATED
  DECLARED
  CONFIRMED
  CANCELLED
}

model TitheGuestGift {
  id          String   @id @default(cuid())
  parishId    String
  parish      Parish   @relation(fields: [parishId], references: [id], onDelete: Cascade)
  campaignId  String?
  campaign    TitheCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  name        String
  email       String
  cpf         String?
  amount      Float
  message     String?
  status      TitheGuestGiftStatus @default(CREATED)
  method      TitheIntentMethod    @default(PIX_STATIC)
  paymentMethod String @default("PIX")
  txid        String   @unique
  brCode      String?
  paymentUrl  String?
  boletoUrl   String?
  boletoLine  String?
  providerRef    String?   @unique
  providerStatus String?
  qrExpiresAt    DateTime?
  amountPaid     Float?
  // Token público para acompanhar/receber o comprovante sem login
  receiptToken   String    @unique
  receiptSentAt  DateTime?
  declaredAt     DateTime?
  confirmedAt    DateTime?
  confirmedByUserId String?
  financialTransactionId String?
  note           String?
  createdByIp    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parishId, status])
  @@index([email, createdAt])
  @@map("tithe_guest_gifts")
}

// Promessa do fiel para uma campanha (o cumprimento é calculado pelas contribuições confirmadas)
model TitheCampaignPledge {
  id         String                    @id @default(cuid())
  campaignId String
  campaign   TitheCampaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member                    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount     Float
  note       String?
  status     TitheCampaignPledgeStatus @default(OPEN)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([campaignId, memberId])
  @@map("tithe_campaign_pledges")
}
