// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  SYSTEM_ADMIN // Administrador do Sistema (Super Admin)
  DIOCESAN_ADMIN // Administrador Diocesano
  PARISH_ADMIN // Administrador Paroquial
  COMMUNITY_COORDINATOR // Coordenador de Comunidade
  PASTORAL_COORDINATOR // Coordenador de Pastoral/Ministério
  VOLUNTEER // Membro/Voluntário
  FAITHFUL // Fiel
}

// Cargo eclesiástico (ordenação) — separado do papel de sistema (UserRole).
// Define o rótulo da mensagem: "Palavra do Bispo/Pároco/Diácono".
enum ClergyTitle {
  BISHOP // Bispo
  PRIEST // Pároco/Padre
  DEACON // Diácono
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  DECEASED
  ANONYMIZED // Dados anonimizados a pedido do titular (LGPD)
  AWAY // Afastado temporariamente
  IN_FORMATION // Em formação
  TRANSFERRED // Transferido para outra comunidade/paróquia
  DISENGAGED // Desligado do serviço pastoral
}

// Classificação funcional do cadastro (tag para filtros/relatórios).
// Independente do papel de acesso (UserRole) e do papel na pastoral.
enum MemberType {
  MEMBER // Membro da comunidade
  AGENT // Agente de pastoral
  COORDINATOR // Coordenador
  CATECHIST // Catequista
  MINISTER // Ministro
  VOLUNTEER // Voluntário
  FAMILY_RESPONSIBLE // Responsável familiar
  CANDIDATE // Candidato/formando
}

// Distingue pastoral, movimento, ministério e serviço.
enum PastoralKind {
  PASTORAL
  MOVEMENT
  MINISTRY
  SERVICE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  COMMON_LAW_MARRIAGE
}

enum SacramentType {
  BAPTISM
  FIRST_COMMUNION
  CONFIRMATION
  MARRIAGE
  HOLY_ORDERS
  ANOINTING_OF_THE_SICK
}

enum EventType {
  MASS
  SACRAMENT
  PASTORAL_MEETING // Reunião de Pastoral
  PASTORAL_ACTIVITY // Atividade de Pastoral
  COMMUNITY_EVENT
  RETREAT
  FORMATION
  VISITATION
}

enum EventStatus {
  DRAFT // Rascunho
  PUBLISHED // Publicado
  CANCELLED // Cancelado
  COMPLETED // Concluído
}

enum RecurrenceType {
  DAILY // Diário
  WEEKLY // Semanal
  MONTHLY // Mensal
  CUSTOM // Personalizado (dias específicos)
}

enum MassScheduleType {
  MASS
  CONFESSION
  ADORATION
  ROSARY
}

enum IntentionType {
  THANKSGIVING
  SUFFRAGE
  SPECIAL
}

enum PrayerRequestCategory {
  HEALTH
  FAMILY
  WORK
  STUDIES
  OTHER
}

enum PrayerRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum NotificationType {
  URGENT_NOTICE
  SCHEDULE_REMINDER
  EVENT_REMINDER
  PRAYER_REQUEST
  MASS_INTENTION_CONFIRMED
  DAILY_LITURGY
  NEWS
  ASSIGNMENT_CREATED
  ASSIGNMENT_DECLINED
  ASSIGNMENT_REPLACED
  SCHEDULE_CANCELLED
  TEAM_BROADCAST
  CLERGY_MESSAGE // Palavra do Pastor (mensagem/vídeo do clero)
  CATECHESIS // Catequese: falta, novo encontro, documentos, mensagem da turma
  PASTORAL_JOIN_REQUEST // "Quero participar": pedido de ingresso numa pastoral (Onda 4)
  TITHE // Dízimo online: Pix declarado/confirmado (projeto Dízimo)
}

// Tipos de consentimento granular (LGPD)
enum ConsentType {
  DATA_PROCESSING // Tratamento de dados pessoais
  IMAGE_USE // Uso de imagem / fotografias
  COMMUNICATIONS // Comunicacoes nao essenciais (opt-in/opt-out)
}

// ============================================
// AUTHENTICATION & USERS
// ============================================

model User {
  id       String   @id @default(cuid())
  email    String   @unique
  password String
  name     String
  phone    String?  @unique
  role     UserRole @default(FAITHFUL)
  isActive Boolean  @default(true)

  // Cargo eclesiástico (ordenação), quando aplicável — Bispo/Pároco/Diácono
  clergyTitle ClergyTitle?

  // Force password change on first login
  forcePasswordChange Boolean @default(false)

  // Scope - Diocese vinculada (para DIOCESAN_ADMIN)
  dioceseId String?
  diocese   Diocese? @relation(fields: [dioceseId], references: [id])

  // Scope - Paróquia vinculada (para PARISH_ADMIN)
  parishId String?
  parish   Parish? @relation(fields: [parishId], references: [id])

  // Scope - Comunidade vinculada (para COMMUNITY_ADMIN)
  communityId String?
  community   Community? @relation("UserCommunity", fields: [communityId], references: [id])

  // 2FA
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String? // cifrado (PAYMENTS_ENCRYPTION_KEY) — TOTP RFC 6238
  twoFactorEnabledAt   DateTime?
  twoFactorLastStep    Int? // último intervalo TOTP aceito (anti-replay)
  twoFactorBackupCodes String[] @default([]) // HMAC-SHA256 (chave do servidor) dos códigos de recuperação
  twoFactorSetupAt     DateTime? // quando o segredo pendente foi gerado (expira em 15 min)
  sessionsRevokedAt    DateTime? // access tokens emitidos antes disto são recusados
  devices UserDevice[]

  // Push notifications (Expo push token)
  pushToken          String?
  pushTokenUpdatedAt DateTime?

  // Aceite de termos de uso / politica de privacidade (LGPD)
  acceptedTermsAt      DateTime?
  acceptedTermsVersion String?

  // Refresh tokens
  refreshTokens RefreshToken[]

  // Tokens de recuperacao de senha (autoatendimento)
  passwordResetTokens PasswordResetToken[]

  // Relations - Many-to-many with communities
  communities UserCommunity[]

  // Favoritos de eventos
  eventFavorites        EventFavorite[]
  // Favoritos de horarios de missa
  massScheduleFavorites MassScheduleFavorite[]

  // Primary community (for quick access)
  primaryCommunityId String?

  // Member profile (if user is a member/faithful)
  member Member?

  // Mensagens do clero enviadas por este usuário (Palavra do Pastor)
  clergyMessagesSent ClergyMessage[] @relation("ClergyMessagesSent")

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastLogin DateTime?

  @@index([email])
  @@index([role])
  catechesisMessages CatechesisMessage[]
  avatar             UserAvatar?

  @@map("users")
}

// Foto de perfil (tabela separada: o binário nunca vaza em includes de User)
model UserAvatar {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mimeType  String
  data      Bytes
  updatedAt DateTime @updatedAt

  @@map("user_avatars")
}

// Dispositivos conhecidos por usuário (D4.7): login em aparelho novo avisa o dono da conta
model UserDevice {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint String
  label       String?
  lastIp      String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  revokedAt   DateTime?

  @@unique([userId, fingerprint])
  @@map("user_devices")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// Tabela de vínculos entre usuário e comunidade (Many-to-Many)
model UserCommunity {
  id String @id @default(cuid())

  // Relations
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  // Role específico nesta comunidade
  role UserRole

  // Status
  isActive  Boolean @default(true)
  isPrimary Boolean @default(false) // Comunidade principal do usuário

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  @@unique([userId, communityId])
  @@index([userId])
  @@index([communityId])
  @@index([isActive])
  @@map("user_communities")
}

// ============================================
// ECCLESIASTICAL STRUCTURE
// ============================================

model Diocese {
  id      String  @id @default(cuid())
  name    String
  address String
  city    String
  state   String
  zipCode String
  phone   String?
  email   String?
  website String?
  logoUrl String?

  // Responsible
  bishopName String?

  // Geolocation
  latitude  Float?
  longitude Float?

  // Metadata
  foundedAt DateTime?
  status    EntityStatus @default(ACTIVE)

  // Relations
  parishes Parish[]
  users    User[] // DIOCESAN_ADMINs vinculados

  // Santos padroeiros + mensagens do clero
  saintPatronages SaintPatronage[]
  clergyMessages  ClergyMessage[]

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dioceses")
}

model Parish {
  id      String  @id @default(cuid())
  name    String
  address String
  city    String
  state   String
  zipCode String
  phone   String?
  email   String?
  website String?
  logoUrl String?

  // Responsible
  priestName String?

  // Geolocation
  latitude  Float?
  longitude Float?

  // Metadata
  foundedAt DateTime?
  status    EntityStatus @default(ACTIVE)

  // Relations
  dioceseId   String
  diocese     Diocese     @relation(fields: [dioceseId], references: [id], onDelete: Cascade)
  communities Community[]
  users       User[] // PARISH_ADMIN vinculados a esta paróquia

  // Fase 3 (catálogos por paróquia)
  catechesisStages CatechesisStage[]
  formationTracks  FormationTrack[]
  formationCourses FormationCourse[]
  pastoralPlans    PastoralPlan[]
  documents        PastoralDocument[]

  // Santos padroeiros + mensagens do clero
  saintPatronages SaintPatronage[]
  clergyMessages  ClergyMessage[]

  // Dízimo online (Fase 1 — Pix da própria paróquia, sem gateway)
  titheEnabled    Boolean @default(false)
  pixKey          String?
  pixKeyType      String? // CPF | CNPJ | EMAIL | PHONE | RANDOM
  pixMerchantName String? // nome do recebedor no BR Code (ASCII, até 25)
  pixMerchantCity String? // cidade do recebedor (ASCII, até 15)
  titheMessage    String? // convite/explicação exibido ao fiel
  // Rastro da última troca da chave (exibido à administração; aviso aos demais admins)
  pixKeyChangedAt       DateTime?
  pixKeyChangedByUserId String?
  // Provedor de pagamento (D3): Pix dinâmico com confirmação automática e recorrência
  paymentProvider      String? // ASAAS | MERCADOPAGO
  providerEnv          String? // sandbox | production
  providerApiKeyEnc    String? // AES-256-GCM (PAYMENTS_ENCRYPTION_KEY)
  providerWebhookToken String? // token que o provedor envia no webhook
  providerConfiguredAt DateTime?
  // Política de taxa: a paróquia absorve ou repassa ao fiel (cobrir a taxa)
  // WhatsApp como canal (D4.5): Pix do mês e "PAGUEI" pelo WhatsApp (Twilio)
  whatsappEnabled Boolean @default(false)
  feePolicy  String @default("ABSORB") // ABSORB | PASS_THROUGH
  feeFixed   Float  @default(0)
  feePercent Float  @default(0)
  titheIntents    TitheIntent[]
  titheSchedules  TitheSchedule[]
  titheCampaigns  TitheCampaign[]
  financialStatements FinancialStatement[]
  guestGifts      TitheGuestGift[]
  webhookEvents   PaymentWebhookEvent[]

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dioceseId])
  @@map("parishes")
}

model Community {
  id      String  @id @default(cuid())
  name    String
  address String
  titheCampaigns TitheCampaign[]
  financialStatements FinancialStatement[]
  city    String
  state   String
  zipCode String
  phone   String?
  email   String?
  website String?
  logoUrl String?

  // Responsible
  coordinatorName String?

  // Geolocation
  latitude  Float?
  longitude Float?

  // Metadata
  foundedAt DateTime?
  status    EntityStatus @default(ACTIVE)

  // Fallback de notificação por SMS (custo controlado por comunidade)
  smsEnabled Boolean @default(false)

  // Relations
  parishId           String
  parish             Parish              @relation(fields: [parishId], references: [id], onDelete: Cascade)
  communityPastorals CommunityPastoral[]
  userCommunities    UserCommunity[]
  users              User[]              @relation("UserCommunity") // COMMUNITY_ADMIN vinculados a esta comunidade
  members            Member[]
  memberLinks        MemberCommunity[]
  events             Event[]
  massSchedules      MassSchedule[]
  massIntentions     MassIntention[]
  prayerRequests     PrayerRequest[]
  news               News[]

  // Fase 3
  catechesisClasses CatechesisClass[]
  pastoralPlans     PastoralPlan[]
  documents         PastoralDocument[]

  // Fase 4
  schedules          Schedule[]
  rooms              Room[]
  sacramentProcesses SacramentProcess[]
  visitRequests      VisitRequest[]

  // Santos padroeiros + mensagens do clero
  saintPatronages SaintPatronage[]
  clergyMessages  ClergyMessage[]

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete (arquivamento)

  @@index([parishId])
  @@index([deletedAt])
  @@map("communities")
}

// ============================================
// PASTORALS, MINISTRIES & MOVEMENTS
// ============================================

// Cadastro Global de Pastorais (criado por SYSTEM_ADMIN)
model GlobalPastoral {
  id          String       @id @default(cuid())
  name        String       @unique // Ex: "Liturgia", "Catequese", "Jovens"
  kind        PastoralKind @default(PASTORAL) // pastoral, movimento, ministério ou serviço
  description String?
  mission     String?
  iconUrl     String?
  colorHex    String? // Cor para identificação visual

  // Metadata
  status EntityStatus @default(ACTIVE)

  // Relations - Vínculos hierárquicos
  diocesanPastorals  DiocesanPastoral[]
  parishPastorals    ParishPastoral[]
  communityPastorals CommunityPastoral[]

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("global_pastorals")
}

// Pastoral vinculada à Diocese
model DiocesanPastoral {
  id          String  @id @default(cuid())
  description String?
  notes       String?

  // Metadata
  foundedAt DateTime?
  status    EntityStatus @default(ACTIVE)

  // Relations
  globalPastoralId String
  globalPastoral   GlobalPastoral @relation(fields: [globalPastoralId], references: [id], onDelete: Cascade)
  dioceseId        String

  // Sub-vínculos
  parishPastorals ParishPastoral[]

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([globalPastoralId, dioceseId])
  @@index([dioceseId])
  @@map("diocesan_pastorals")
}

// Pastoral vinculada à Paróquia
model ParishPastoral {
  id          String  @id @default(cuid())
  description String?
  notes       String?

  // Metadata
  foundedAt DateTime?
  status    EntityStatus @default(ACTIVE)

  // Relations
  globalPastoralId   String
  globalPastoral     GlobalPastoral    @relation(fields: [globalPastoralId], references: [id], onDelete: Cascade)
  diocesanPastoralId String?
  diocesanPastoral   DiocesanPastoral? @relation(fields: [diocesanPastoralId], references: [id], onDelete: SetNull)
  parishId           String

  // Sub-vínculos
  communityPastorals CommunityPastoral[]

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([globalPastoralId, parishId])
  @@index([parishId])
  @@map("parish_pastorals")
}

// Pastoral vinculada à Comunidade (nível operacional)
model CommunityPastoral {
  id          String  @id @default(cuid())
  description String?
  mission     String?
  photoUrl    String?
  notes       String?

  // Regra de escala: casais servem juntos (rodízio puxa o cônjuge quando possível)
  scheduleCouplesTogether Boolean @default(false)

  // Regra de escala: esta pastoral escala GRUPOS/equipes (ex.: música), não pessoas
  scheduleByGroup Boolean @default(false)

  // Metadata
  foundedAt DateTime?
  status    EntityStatus @default(ACTIVE)

  // Relations
  globalPastoralId String
  globalPastoral   GlobalPastoral  @relation(fields: [globalPastoralId], references: [id], onDelete: Cascade)
  parishPastoralId String?
  parishPastoral   ParishPastoral? @relation(fields: [parishPastoralId], references: [id], onDelete: SetNull)
  communityId      String
  community        Community       @relation(fields: [communityId], references: [id], onDelete: Cascade)

  // Sub-grupos
  subGroups PastoralGroup[]

  // Membros
  members PastoralMember[]

  // Eventos (reuniões, atividades, missas, etc)
  eventPastorals EventPastoral[]

  // Escalas
  schedulePastorals   SchedulePastoral[]
  scheduleAssignments ScheduleAssignment[]

  // Vínculo com horários fixos (agenda fixa)
  massSchedulePastorals MassSchedulePastoral[]

  // Histórico de coordenadores
  coordinatorHistory PastoralCoordinator[]

  // Mensagens do clero direcionadas à pastoral
  clergyMessages ClergyMessage[]

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  @@unique([globalPastoralId, communityId])
  @@index([communityId])
  @@index([deletedAt])
  joinRequests PastoralJoinRequest[]

  @@map("community_pastorals")
}

// Sub-grupos de uma Pastoral (ex: Liturgia → Coral, Ministros)
model PastoralGroup {
  id          String  @id @default(cuid())
  name        String // Ex: "Coral", "Ministros da Eucaristia"
  description String?
  photoUrl    String?

  // Metadata
  status EntityStatus @default(ACTIVE)

  // Relations
  communityPastoralId String
  communityPastoral   CommunityPastoral @relation(fields: [communityPastoralId], references: [id], onDelete: Cascade)

  // Hierarquia de sub-grupos
  parentGroupId String?
  parentGroup   PastoralGroup?  @relation("SubGroups", fields: [parentGroupId], references: [id], onDelete: SetNull)
  subGroups     PastoralGroup[] @relation("SubGroups")

  // Membros
  members PastoralMember[]

  // Escalas em que o grupo foi escalado como unidade
  scheduleAssignments ScheduleAssignment[]

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  @@index([communityPastoralId])
  @@index([deletedAt])
  @@map("pastoral_groups")
}

// Membros de uma Pastoral ou Sub-grupo
model PastoralMember {
  id   String  @id @default(cuid())
  role String? // Ex: "Coordenador", "Vice-coordenador", "Membro"

  // Metadata
  isActive Boolean @default(true)

  // Relations
  communityPastoralId String?
  communityPastoral   CommunityPastoral? @relation(fields: [communityPastoralId], references: [id], onDelete: Cascade)
  pastoralGroupId     String?
  pastoralGroup       PastoralGroup?     @relation(fields: [pastoralGroupId], references: [id], onDelete: Cascade)
  memberId            String
  member              Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Audit
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  // Proteção contra vínculos duplicados (NULLs não conflitam no Postgres:
  // vínculo de pastoral e vínculo de grupo convivem para o mesmo membro)
  @@unique([memberId, communityPastoralId])
  @@unique([memberId, pastoralGroupId])
  @@index([communityPastoralId])
  @@index([pastoralGroupId])
  @@index([memberId])
  @@map("pastoral_members")
}

// Histórico de Coordenadores de uma Pastoral
model PastoralCoordinator {
  id String @id @default(cuid())

  // Relations
  communityPastoralId String
  communityPastoral   CommunityPastoral @relation(fields: [communityPastoralId], references: [id], onDelete: Cascade)
  memberId            String
  member              Member            @relation("PastoralCoordinators", fields: [memberId], references: [id], onDelete: Cascade)

  // Período de coordenação
  startDate DateTime
  endDate   DateTime?
  isCurrent Boolean   @default(false)

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([communityPastoralId])
  @@index([memberId])
  @@map("pastoral_coordinators")
}

// ============================================
// MEMBERS & FAITHFUL
// ============================================

model Member {
  id String @id @default(cuid())

  // Personal Info
  fullName      String
  birthDate     DateTime?
  cpf           String?        @unique
  rg            String?
  gender        Gender?
  maritalStatus MaritalStatus?
  occupation    String?
  photoUrl      String?

  // Contact
  phone        String?
  email        String?
  zipCode      String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?

  // Classificação funcional (tag para filtros/relatórios)
  memberType MemberType?

  // Contato de emergência
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  // Family
  fatherName String?
  motherName String?
  spouseId   String? @unique
  spouse     Member? @relation("Spouse", fields: [spouseId], references: [id])
  spouseOf   Member? @relation("Spouse")

  // Responsible (for minors without app access)
  responsibleId String?
  responsible   Member?  @relation("Responsible", fields: [responsibleId], references: [id])
  dependents    Member[] @relation("Responsible")

  // Status
  status MemberStatus @default(ACTIVE)

  // LGPD Consent (flag legada de tratamento de dados; consentimentos
  // granulares ficam no modelo Consent)
  consentGiven Boolean   @default(false)
  consentDate  DateTime?

  // Consentimentos granulares (LGPD): tratamento, imagem, comunicacoes
  consents Consent[]

  // Relations
  userId      String?   @unique
  user        User?     @relation(fields: [userId], references: [id])
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  // Pastorals
  pastoralMemberships      PastoralMember[]          @relation
  pastoralCoordinations    PastoralCoordinator[]     @relation("PastoralCoordinators")
  eventPastoralAssignments EventPastoralAssignment[] @relation("EventPastoralAssignments")

  // Sacraments
  sacraments Sacrament[]

  // Prayer Requests
  prayerRequests PrayerRequest[]

  // Schedule Assignments
  scheduleAssignments ScheduleAssignment[]

  // Availability for schedules
  availabilityRules      MemberAvailabilityRule[]
  availabilityExceptions MemberAvailabilityException[]

  // Catequese (Fase 3)
  catechesisEnrollments CatechesisEnrollment[]
  catechesisCatechistOf CatechesisCatechist[]

  // Formação de agentes (Fase 3)
  formationEnrollments FormationEnrollment[]

  // Planejamento pastoral (Fase 3) — ações sob responsabilidade
  responsibleActions PastoralAction[] @relation("ActionResponsible")

  // Fase 4
  tither             Tither?
  sacramentProcesses SacramentProcess[]

  // Mensagens do clero direcionadas ao membro
  clergyMessages ClergyMessage[]

  // Event Participations
  eventParticipations EventParticipant[]

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  // Vínculos multi-comunidade (principal + secundárias)
  communityLinks MemberCommunity[]

  @@index([communityId])
  @@index([email])
  @@index([cpf])
  @@index([deletedAt])
  pastoralJoinRequests PastoralJoinRequest[]
  titheIntents         TitheIntent[]

  // Dízimo: lembrete mensal opt-in (dia 1..28) e dedupe do mês já lembrado
  titheReminderDay       Int?
  titheReminderSentMonth String?
  // Opt-in para receber o Pix do mês pelo WhatsApp (D4.5)
  whatsappOptIn   Boolean   @default(false)
  whatsappOptInAt DateTime?
  providerCustomers MemberProviderCustomer[]
  titheSchedules    TitheSchedule[]
  titheCampaignPledges TitheCampaignPledge[]
  titheRetentionActions TitheRetentionAction[]

  @@map("members")
}

// Vínculo N:N membro↔comunidades: a comunidade principal (isPrimary) é
// espelhada em Member.communityId durante a transição; as demais são
// secundárias (o membro fica visível/escalável para os coordenadores delas).
model MemberCommunity {
  id String @id @default(cuid())

  memberId    String
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  isPrimary Boolean @default(false)
  isActive  Boolean @default(true)

  // LGPD: consentimento por vínculo (o vínculo expõe o membro à comunidade)
  consentGiven Boolean   @default(false)
  consentDate  DateTime?

  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  @@unique([memberId, communityId])
  @@index([communityId])
  @@index([memberId])
  @@map("member_communities")
}

model Sacrament {
  id       String        @id @default(cuid())
  type     SacramentType
  date     DateTime
  place    String?
  minister String? // Priest/Deacon name
  notes    String?

  // Numeração do registro oficial (Fase 4.4 — certidão)
  book String? // livro
  page String? // folha
  term String? // termo

  // Relations
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([type])
  @@map("sacraments")
}

// ============================================
// EVENTS & CALENDAR
// ============================================

model Event {
  id                 String          @id @default(cuid())
  title              String
  description        String?
  type               EventType
  startDate          DateTime
  endDate            DateTime?
  location           String?
  notes              String? // Notas adicionais
  isRecurring        Boolean         @default(false)
  recurrenceType     RecurrenceType?
  recurrenceInterval Int?            @default(1) // A cada X dias/semanas/meses
  recurrenceDays     String? // JSON array de dias da semana [0-6] ou datas específicas
  recurrenceEndDate  DateTime? // Data de término da recorrência
  recurrenceRule     String? // iCal RRULE format (opcional, para compatibilidade)

  // Metadata
  maxParticipants Int?
  isPublic        Boolean     @default(true)
  status          EventStatus @default(DRAFT)

  // Relations
  communityId    String
  community      Community          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  schedules      Schedule[]
  participants   EventParticipant[]
  eventPastorals EventPastoral[] // Pastorais vinculadas ao evento
  favorites      EventFavorite[]

  // Planejamento pastoral (Fase 3): vincula a atividade a um objetivo,
  // evitando que o sistema seja apenas uma agenda de tarefas.
  objectiveId String?
  objective   PastoralObjective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  @@index([communityId])
  @@index([startDate])
  @@index([type])
  @@index([status])
  @@index([objectiveId])
  @@index([deletedAt])
  @@map("events")
}

model EventParticipant {
  id String @id @default(cuid())

  // Relations
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Metadata
  registeredAt DateTime @default(now())
  attended     Boolean  @default(false)
  notes        String?

  @@unique([eventId, memberId])
  @@index([eventId])
  @@index([memberId])
  @@map("event_participants")
}

model EventFavorite {
  id String @id @default(cuid())

  // Relations
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Audit
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@map("event_favorites")
}

model EventPastoral {
  id String @id @default(cuid())

  // Relations
  eventId             String
  event               Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  communityPastoralId String
  communityPastoral   CommunityPastoral @relation(fields: [communityPastoralId], references: [id], onDelete: Cascade)

  // Metadata
  role           String? // Ex: "Responsável pela música", "Responsável pela liturgia"
  isLeader       Boolean @default(false) // Pastoral principal/organizadora
  requiredPeople Int     @default(0)
  notes          String?

  // Escalas específicas desta pastoral neste evento
  assignments EventPastoralAssignment[]

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, communityPastoralId])
  @@index([eventId])
  @@index([communityPastoralId])
  @@map("event_pastorals")
}

model EventPastoralAssignment {
  id String @id @default(cuid())

  // Relations
  eventPastoralId String
  eventPastoral   EventPastoral @relation(fields: [eventPastoralId], references: [id], onDelete: Cascade)
  memberId        String
  member          Member        @relation("EventPastoralAssignments", fields: [memberId], references: [id], onDelete: Cascade)

  // Metadata
  role        String // Ex: "Ministro", "Leitor", "Cantor", "Violão"
  checkedIn   Boolean   @default(false)
  checkedInAt DateTime?
  notes       String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventPastoralId])
  @@index([memberId])
  @@map("event_pastoral_assignments")
}

// ============================================
// SCHEDULES & ASSIGNMENTS
// ============================================

model Schedule {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime

  // Relations
  // eventId agora é OPCIONAL (Fase 4.1): escalas de serviços contínuos
  // (limpeza, secretaria, dízimo, adoração) não exigem evento artificial.
  eventId        String?
  event          Event?               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // Escala sem evento fica ancorada diretamente na comunidade + horário próprio
  communityId    String?
  community      Community?           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  // Escala originada de um horário fixo (agenda fixa), quando aplicável
  massScheduleId String?
  massSchedule   MassSchedule?        @relation(fields: [massScheduleId], references: [id], onDelete: SetNull)
  startTime      String? // HH:MM (quando não há evento)
  endTime        String? // HH:MM
  location       String?
  assignments    ScheduleAssignment[]
  pastorals      SchedulePastoral[]
  status         ScheduleStatus       @default(OPEN)

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  @@index([eventId])
  @@index([communityId])
  @@index([massScheduleId])
  @@index([date])
  @@index([deletedAt])
  @@map("schedules")
}

model SchedulePastoral {
  id String @id @default(cuid())

  // Relations
  scheduleId          String
  schedule            Schedule          @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  communityPastoralId String
  communityPastoral   CommunityPastoral @relation(fields: [communityPastoralId], references: [id], onDelete: Cascade)

  // Metadata
  role           String?
  isLeader       Boolean @default(false)
  requiredPeople Int     @default(0)

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scheduleId, communityPastoralId])
  @@index([scheduleId])
  @@index([communityPastoralId])
  @@map("schedule_pastorals")
}

model ScheduleAssignment {
  id          String           @id @default(cuid())
  role        String // e.g., "Leitor", "Ministro", "Acólito"
  status      AssignmentStatus @default(PENDING) // Status da confirmação
  checkedIn   Boolean          @default(false)
  checkedInAt DateTime?

  // Deduplicação dos lembretes automáticos (jobs/schedule-reminders)
  reminder24hSentAt  DateTime?
  reminder2hSentAt   DateTime?
  pendingNudgeSentAt DateTime? // Cobrança de resposta para PENDING próximo da data

  // Auditoria da resposta (confirmação assistida: coordenador responde pelo membro)
  respondedByUserId String?
  respondedAt       DateTime?

  // Justificativa da recusa (Fase 4.6)
  declineReason String?

  // Pedidos de troca (swap) associados a esta atribuição (Fase 4.6)
  swapRequests AssignmentSwapRequest[]

  // Relations
  scheduleId          String
  schedule            Schedule           @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  memberId            String
  member              Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  communityPastoralId String?
  communityPastoral   CommunityPastoral? @relation(fields: [communityPastoralId], references: [id], onDelete: SetNull)
  // Grupo/equipe escalado como unidade (pastorais com scheduleByGroup)
  pastoralGroupId     String?
  pastoralGroup       PastoralGroup?     @relation(fields: [pastoralGroupId], references: [id], onDelete: SetNull)

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Um membro entra no máximo uma vez por escala (regra já validada no código)
  @@unique([scheduleId, memberId])
  @@index([scheduleId])
  @@index([pastoralGroupId])
  @@index([memberId])
  @@index([communityPastoralId])
  @@index([status])
  @@map("schedule_assignments")
}

enum AssignmentStatus {
  PENDING // Aguardando confirmação
  CONFIRMED // Confirmado
  DECLINED // Recusado
  EXPIRED // Prazo de resposta estourado (Fase 4.6)
}

enum SwapStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

enum ScheduleStatus {
  OPEN
  CLOSED
  COMPLETED
  CANCELLED
}

model MemberAvailabilityRule {
  id String @id @default(cuid())

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  dayOfWeek    Int
  startMinutes Int
  endMinutes   Int
  isActive     Boolean @default(true)
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([dayOfWeek])
  @@map("member_availability_rules")
}

model MemberAvailabilityException {
  id String @id @default(cuid())

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([startDate])
  @@index([endDate])
  @@map("member_availability_exceptions")
}

// ============================================
// MASS SCHEDULES
// ============================================

model MassSchedule {
  id          String           @id @default(cuid())
  dayOfWeek   Int // 0 = Sunday, 6 = Saturday
  time        String // HH:MM format
  type        MassScheduleType
  notes       String?
  isSpecial   Boolean          @default(false)
  specialDate DateTime?

  // Relations
  communityId String
  community   Community              @relation(fields: [communityId], references: [id], onDelete: Cascade)
  favorites   MassScheduleFavorite[]
  // Pastorais vinculadas ao horário fixo (base para gerar escalas)
  pastorals   MassSchedulePastoral[]
  // Escalas geradas a partir deste horário fixo
  schedules   Schedule[]

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([communityId])
  @@index([dayOfWeek])
  @@map("mass_schedules")
}

// Vínculo de pastoral a um horário fixo (espelha EventPastoral).
// Ao gerar uma escala para uma data, estas pastorais viram SchedulePastoral.
model MassSchedulePastoral {
  id String @id @default(cuid())

  // Relations
  massScheduleId      String
  massSchedule        MassSchedule      @relation(fields: [massScheduleId], references: [id], onDelete: Cascade)
  communityPastoralId String
  communityPastoral   CommunityPastoral @relation(fields: [communityPastoralId], references: [id], onDelete: Cascade)

  // Metadata
  role           String?
  isLeader       Boolean @default(false)
  requiredPeople Int     @default(0)

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([massScheduleId, communityPastoralId])
  @@index([massScheduleId])
  @@index([communityPastoralId])
  @@map("mass_schedule_pastorals")
}

model MassScheduleFavorite {
  id String @id @default(cuid())

  // Relations
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  massScheduleId String
  massSchedule   MassSchedule @relation(fields: [massScheduleId], references: [id], onDelete: Cascade)

  // Audit
  createdAt DateTime @default(now())

  @@unique([userId, massScheduleId])
  @@index([userId])
  @@index([massScheduleId])
  @@map("mass_schedule_favorites")
}

// ============================================
// MASS INTENTIONS
// ============================================

model MassIntention {
  id            String        @id @default(cuid())
  intentionFor  String // Name of the person
  type          IntentionType
  requestedDate DateTime
  notes         String?

  // Payment
  amount        Float?
  isPaid        Boolean   @default(false)
  paidAt        DateTime?
  paymentMethod String?

  // Relations
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  requestedBy String // User email or name

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([communityId])
  @@index([requestedDate])
  @@map("mass_intentions")
}

// ============================================
// PRAYER REQUESTS
// ============================================

model PrayerRequest {
  id          String                @id @default(cuid())
  title       String
  description String
  category    PrayerRequestCategory
  isAnonymous Boolean               @default(false)
  status      PrayerRequestStatus   @default(PENDING)
  prayerCount Int                   @default(0)

  // Relations
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  memberId    String?
  member      Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([communityId])
  @@index([status])
  @@index([category])
  @@map("prayer_requests")
}

// ============================================
// NEWS & ANNOUNCEMENTS
// ============================================

model News {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String // "Aviso Urgente", "Notícia", "Evento", "Formação"
  imageUrl    String?
  isUrgent    Boolean  @default(false)
  publishedAt DateTime @default(now())

  // Relations
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([communityId])
  @@index([publishedAt])
  @@index([category])
  @@map("news")
}

// ============================================
// FINANCIAL TRANSACTIONS
// ============================================

model FinancialTransaction {
  id          String          @id @default(cuid())
  type        TransactionType
  category    String
  amount      Float
  description String?
  date        DateTime

  // Bank account (optional)
  accountName String?
  // Centro de custo (D4.3): Pastoral, Obras, Administrativo, Caridade… (livre, sugerido pela paróquia)
  costCenter  String?

  // Relations
  communityId String?
  parishId    String?
  dioceseId   String?

  // Campanha/fundo (D4.1): lançamento com finalidade
  campaignId String?
  campaign   TitheCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  // Origem: Pix/cobrança do app que gerou o lançamento (null = manual); estorno aponta o lançamento estornado
  titheIntentId String?
  reversalOfId  String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([date])
  @@index([communityId])
  @@index([campaignId])
  @@index([titheIntentId])
  @@index([parishId, date])
  @@map("financial_transactions")
}

// ===== Transparência (D4.3): balancete mensal com aprovação e publicação =====
enum FinancialStatementStatus {
  DRAFT // gerado, em revisão
  APPROVED // aprovado pelo Conselho de Assuntos Econômicos (registrado pela administração)
  PUBLISHED // visível aos fiéis no app/web
}

model FinancialStatement {
  id          String   @id @default(cuid())
  parishId    String
  parish      Parish   @relation(fields: [parishId], references: [id], onDelete: Cascade)
  // null = paróquia inteira; senão o balancete da comunidade
  communityId String?
  community   Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  // Chave de unicidade sem NULL: 'PARISH' ou o id da comunidade
  scopeKey       String
  referenceMonth String // AAAA-MM
  status         FinancialStatementStatus @default(DRAFT)
  // Fotografia dos totais (sem dado individual): receitas/despesas por categoria e centro de custo, campanhas, saldo
  snapshot       Json
  notes          String?
  generatedAt       DateTime  @default(now())
  generatedByUserId String?
  approvedAt        DateTime?
  approvedByUserId  String?
  approvedByName    String?
  publishedAt       DateTime?
  publishedByUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parishId, scopeKey, referenceMonth])
  @@index([parishId, status])
  @@map("financial_statements")
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id    String           @id @default(cuid())
  title String
  body  String
  type  NotificationType
  data  Json? // Additional data

  // Targeting
  userId      String?
  communityId String?
  parishId    String?
  dioceseId   String?

  // Status
  isSent Boolean   @default(false)
  sentAt DateTime?

  // Audit
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isSent])
  @@index([type])
  @@map("notifications")
}

model PhoneOtp {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("phone_otps")
}

// Token de recuperacao de senha (autoatendimento).
// Guardamos apenas o hash do token; o valor em claro so existe no link/SMS enviado.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

// Consentimento granular (LGPD). Um registro por (member, type), atualizado
// quando o titular concede/revoga. Historico de mudancas fica em AuditLog.
model Consent {
  id              String      @id @default(cuid())
  memberId        String
  member          Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type            ConsentType
  granted         Boolean     @default(false)
  policyVersion   String? // versao da politica/termos vigente no aceite
  grantedByUserId String? // quem registrou (titular, responsavel ou gestor)
  grantedAt       DateTime?
  revokedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, type])
  @@index([memberId])
  @@index([type])
  @@map("consents")
}

// ============================================
// AUDIT TRAIL (LGPD / rastreabilidade)
// ============================================

// Trilha de auditoria append-only: quem fez o quê, em qual entidade, quando.
// Nunca atualizar ou excluir registros desta tabela pela aplicação.
model AuditLog {
  id String @id @default(cuid())

  // Quem (snapshot no momento da ação; actorUserId pode apontar para usuário removido)
  actorUserId String?
  actorEmail  String?
  actorRole   String?

  // O quê
  action   String // CREATE | UPDATE | SOFT_DELETE | READ_SENSITIVE | EXPORT | ANONYMIZE | CONSENT_CHANGE | PASSWORD_RESET | REGISTER
  entity   String // Ex.: "Member", "User", "PrayerRequest", "Community"
  entityId String?

  // Detalhes (não armazenar dados pessoais em claro quando a ação for ANONYMIZE)
  before   Json?
  after    Json?
  metadata Json?
  ip       String?

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// FASE 3 — CATEQUESE
// ============================================

enum CatechesisEnrollmentStatus {
  ACTIVE
  TRANSFERRED
  COMPLETED
  DROPPED_OUT
  PENDING_APPROVAL // Inscrição online aguardando a coordenação
  REJECTED // Inscrição não aprovada
  WAITLISTED // Fila de espera (turma cheia) — NÃO ocupa vaga; aceite abre +1
}

// Comportamento da inscrição online quando a turma está cheia
enum CatechesisFullBehavior {
  WAITLIST // aceita o pedido numa fila de espera (a coordenação decide)
  BLOCK // recusa na hora: a turma não aceita mais inscrições no ano
}

// Catálogo de etapas por paróquia (ex.: "1ª Eucaristia - Ano 1", "Crisma")
model CatechesisStage {
  id            String         @id @default(cuid())
  name          String
  description   String?
  ordering      Int            @default(0)
  // Cor da etapa (hex #rrggbb) — diferencia os "tempos" em cards e listas
  color         String?
  parishId      String
  parish        Parish         @relation(fields: [parishId], references: [id], onDelete: Cascade)
  // Sacramento gerado automaticamente na conclusão da etapa (opcional)
  sacramentType SacramentType?

  classes CatechesisClass[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([parishId])
  @@index([deletedAt])
  @@map("catechesis_stages")
}

model CatechesisClass {
  id      String  @id @default(cuid())
  name    String
  year    Int
  weekday Int?
  time    String?
  room    String?
  // Vagas da turma (null = sem limite); inscrição online respeita o limite
  capacity Int?

  // Inscrições online: chave geral + janela opcional (null = sem restrição).
  // Fim de ano: fecha as turmas do ano corrente e abre as do ano novo.
  enrollmentOpen     Boolean   @default(true)
  enrollmentOpensAt  DateTime?
  enrollmentClosesAt DateTime?
  // Turma cheia: fila de espera (padrão) ou bloqueio da inscrição
  fullBehavior CatechesisFullBehavior @default(WAITLIST)

  stageId     String
  stage       CatechesisStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  communityId String
  community   Community       @relation(fields: [communityId], references: [id], onDelete: Cascade)

  catechists      CatechesisCatechist[]
  enrollments     CatechesisEnrollment[]
  sessions        CatechesisSession[]
  fees            CatechesisFee[]
  docRequirements CatechesisClassDocRequirement[]

  status EntityStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([stageId])
  @@index([communityId])
  @@index([deletedAt])
  @@map("catechesis_classes")
}

// Catequistas/auxiliares de uma turma (N:N com Member)
model CatechesisCatechist {
  id       String          @id @default(cuid())
  classId  String
  class    CatechesisClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  memberId String
  member   Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role     String? // "Catequista" | "Auxiliar"

  createdAt DateTime @default(now())

  @@unique([classId, memberId])
  @@index([classId])
  @@index([memberId])
  @@map("catechesis_catechists")
}

// Matrícula do catequizando em uma turma
model CatechesisEnrollment {
  id       String          @id @default(cuid())
  classId  String
  class    CatechesisClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  memberId String
  member   Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)

  status           CatechesisEnrollmentStatus @default(ACTIVE)
  pendingDocuments String?
  rejectionReason  String? // motivo da recusa, visível à família no app
  // Catecumenato: catequizando (7+) ainda NÃO batizado — faz 1 ano de catequese
  // antes de receber o Batismo; não há certidão a cobrar. O painel calcula
  // "apto ao Batismo" e o aviso some quando o Batismo entra nos sacramentos.
  unbaptized       Boolean                    @default(false)
  // Instante de ENTRADA NA FILA de espera (ordem justa): enrolledAt não serve —
  // reativar matrícula antiga furaria a fila com a data original
  waitlistedAt     DateTime?
  // Uso de imagem (fotos/vídeos dos encontros e eventos): true = autorizado,
  // false = negado, null = não respondido (matrícula antiga ou feita no papel)
  imageConsent     Boolean?
  imageConsentAt   DateTime?
  enrolledAt       DateTime                   @default(now())
  completedAt      DateTime?

  attendances CatechesisAttendance[]
  assessments CatechesisAssessment[]
  feePayments CatechesisFeePayment[]
  documents   CatechesisDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, memberId])
  @@index([classId])
  @@index([memberId])
  @@index([status])
  messages    CatechesisMessage[]

  @@map("catechesis_enrollments")
}

model CatechesisSession {
  id      String          @id @default(cuid())
  classId String
  class   CatechesisClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  date    DateTime
  topic   String?

  attendances CatechesisAttendance[]

  createdAt DateTime @default(now())

  @@unique([classId, date])
  @@index([classId])
  @@map("catechesis_sessions")
}

// Situação do documento enviado pela família
enum CatechesisDocumentStatus {
  SUBMITTED // Enviado, aguardando conferência
  VERIFIED // Conferido pela coordenação (binário apagado)
  REJECTED // Recusado — reenviar (binário apagado)
}

// Documento da matrícula enviado pelo app (ex.: Certidão de Batismo).
// RETENÇÃO MÍNIMA: o binário (data) só existe enquanto SUBMITTED — a
// conferência (ou recusa) apaga o arquivo e preserva apenas o registro.
model CatechesisDocument {
  id           String               @id @default(cuid())
  enrollmentId String
  enrollment   CatechesisEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  kind      String // "Certidão de Batismo" — espelha a pendência
  fileName  String
  mimeType  String
  sizeBytes Int
  data      Bytes? // aceito fica ARMAZENADO (prontuário; cascade com a matrícula); null quando recusado ou conferido antes de 02/09/2026

  // Declaração SEM arquivo: "não tem" o documento, ou batismo de OUTRA
  // denominação (qual em `denomination`) — a equipe aceita/recusa no mesmo
  // fluxo de conferência dos arquivos
  declaration  CatechesisDocDeclaration?
  denomination String?

  // Conferência automática (IA): o documento é do tipo pedido e o nome/data
  // de nascimento batem com o cadastro do catequizando? Auxiliar — a decisão
  // final continua sendo da equipe
  autoCheckStatus CatechesisDocAutoCheck?
  autoCheckNotes  String?
  // Valores LIDOS do documento (estruturados): permitem oferecer ao
  // responsável "corrigir o cadastro conforme o documento"; morrem na recusa
  extractedName      String?
  extractedBirthDate DateTime?

  status       CatechesisDocumentStatus @default(SUBMITTED)
  reviewNotes  String?
  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enrollmentId])
  @@index([status])
  @@map("catechesis_documents")
}

enum CatechesisDocDeclaration {
  NOT_HAVE // responsável declara que o catequizando não tem o documento
  OTHER_DENOMINATION // batismo em outra denominação cristã (informa qual)
}

enum CatechesisDocAutoCheck {
  MATCH // documento do tipo pedido, nome e nascimento conferem
  MISMATCH // alguma divergência com o cadastro
  UNREADABLE // não deu para ler/extrair os dados
  SKIPPED // conferência automática indisponível (sem chave/erro/arquivo grande)
}

// Documentos que a TURMA pede na inscrição — o coordenador define quais e se
// são obrigatórios; sem cadastro, valem os padrões (certidão de nascimento
// obrigatória; CPF e batismo opcionais com "não tenho").
model CatechesisClassDocRequirement {
  id      String          @id @default(cuid())
  classId String
  class   CatechesisClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  kind                   String
  required               Boolean @default(false)
  allowNotHave           Boolean @default(false) // responsável pode declarar que não tem
  allowOtherDenomination Boolean @default(false) // batismo de outra denominação (informa qual)
  ordering               Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, kind])
  @@index([classId])
  @@map("catechesis_class_doc_requirements")
}

// Conceito do parecer por período (Fase 5)
enum CatechesisRating {
  EXCELLENT // Ótimo
  GOOD // Bom
  REGULAR // Regular
  NEEDS_ATTENTION // Precisa de atenção
}

// Parecer descritivo do catequista por período, visível à família (Fase 5)
model CatechesisAssessment {
  id           String               @id @default(cuid())
  enrollmentId String
  enrollment   CatechesisEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  period      String // "1º semestre 2026"
  rating      CatechesisRating?
  notes       String // parecer descritivo
  createdById String? // usuário (catequista) que escreveu

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrollmentId, period])
  @@index([enrollmentId])
  @@map("catechesis_assessments")
}

// Taxa de material da turma (Fase 5) — opcional: existe se a coordenação criar
model CatechesisFee {
  id      String          @id @default(cuid())
  classId String
  class   CatechesisClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  description String // "Material 2026"
  amount      Float
  dueDate     DateTime?

  payments CatechesisFeePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId])
  @@map("catechesis_fees")
}

// Pagamento (ou isenção) da taxa por matrícula, ligado ao financeiro
model CatechesisFeePayment {
  id           String               @id @default(cuid())
  feeId        String
  fee          CatechesisFee        @relation(fields: [feeId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   CatechesisEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  amount        Float // 0 quando isento
  method        String? // "Dinheiro", "Pix"...
  waived        Boolean @default(false) // isenção pastoral
  transactionId String? // FinancialTransaction gerada (quando pago)

  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([feeId, enrollmentId])
  @@index([enrollmentId])
  @@map("catechesis_fee_payments")
}

model CatechesisAttendance {
  id           String               @id @default(cuid())
  sessionId    String
  session      CatechesisSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   CatechesisEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  present      Boolean              @default(false)
  // Presente com atraso (conta como presença; marcação para o acompanhamento)
  late         Boolean              @default(false)
  // Falta justificada (só faz sentido com present=false); atestado opcional
  // anexado à falta — apagados juntos quando a marcação deixa de ser justificada
  justified     Boolean @default(false)
  justification String?
  certificateName String?
  certificateMime String?
  certificateSize Int?
  certificateData Bytes?

  // Quem marcou/alterou por último (auditoria leve de presença)
  markedById String?
  updatedAt  DateTime @updatedAt

  @@unique([sessionId, enrollmentId])
  @@index([sessionId])
  @@index([enrollmentId])
  @@map("catechesis_attendances")
}

// ============================================
// FASE 3 — PLANEJAMENTO PASTORAL
// ============================================

enum PlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ActionStatus {
  PLANNED
  IN_PROGRESS
  DONE
  CANCELLED
}

model PastoralPlan {
  id    String @id @default(cuid())
  title String
  year  Int

  parishId    String
  parish      Parish     @relation(fields: [parishId], references: [id], onDelete: Cascade)
  communityId String?
  community   Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)

  status PlanStatus @default(DRAFT)

  objectives PastoralObjective[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([parishId])
  @@index([communityId])
  @@index([deletedAt])
  @@map("pastoral_plans")
}

model PastoralObjective {
  id          String       @id @default(cuid())
  planId      String
  plan        PastoralPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  description String

  goals   PastoralGoal[]
  actions PastoralAction[]
  events  Event[] // atividades vinculadas a este objetivo

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@map("pastoral_objectives")
}

model PastoralGoal {
  id           String            @id @default(cuid())
  objectiveId  String
  objective    PastoralObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  description  String
  indicator    String? // o que medir
  targetValue  String? // meta
  currentValue String? // valor atual

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([objectiveId])
  @@map("pastoral_goals")
}

model PastoralAction {
  id          String            @id @default(cuid())
  objectiveId String
  objective   PastoralObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  title       String
  dueDate     DateTime?
  status      ActionStatus      @default(PLANNED)

  responsibleMemberId String?
  responsibleMember   Member? @relation("ActionResponsible", fields: [responsibleMemberId], references: [id], onDelete: SetNull)

  // Registro de resultados, dificuldades e aprendizados (encerramento do projeto)
  resultNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([objectiveId])
  @@index([status])
  @@map("pastoral_actions")
}

// ============================================
// FASE 3 — DOCUMENTOS E MEMÓRIA PASTORAL
// ============================================

model PastoralDocument {
  id       String @id @default(cuid())
  title    String
  category String // ata, planejamento, regimento, manual, prestação de contas, etc.

  parishId            String
  parish              Parish     @relation(fields: [parishId], references: [id], onDelete: Cascade)
  communityId         String?
  community           Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)
  // Vínculo opcional a uma pastoral (continuidade após troca de coordenação)
  communityPastoralId String?

  responsibleMemberId String?

  // Storage: a chave/URL do arquivo. O upload real ao S3 fica para etapa posterior;
  // por ora guardamos a referência (a memória e os metadados já são preservados).
  storageKey     String?
  fileUrl        String?
  currentVersion Int       @default(1)
  validUntil     DateTime?
  isArchived     Boolean   @default(false)

  versions DocumentVersion[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([parishId])
  @@index([communityId])
  @@index([communityPastoralId])
  @@index([category])
  @@index([deletedAt])
  @@map("pastoral_documents")
}

model DocumentVersion {
  id              String           @id @default(cuid())
  documentId      String
  document        PastoralDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version         Int
  storageKey      String?
  fileUrl         String?
  notes           String?
  createdByUserId String?

  createdAt DateTime @default(now())

  @@unique([documentId, version])
  @@index([documentId])
  @@map("document_versions")
}

// ============================================
// FASE 3 — FORMAÇÃO DE AGENTES
// ============================================

enum FormationEnrollmentStatus {
  ENROLLED
  COMPLETED
  FAILED
  CANCELLED
}

model FormationTrack {
  id          String  @id @default(cuid())
  name        String
  description String?

  parishId String
  parish   Parish @relation(fields: [parishId], references: [id], onDelete: Cascade)

  courses FormationCourse[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([parishId])
  @@index([deletedAt])
  @@map("formation_tracks")
}

model FormationCourse {
  id          String  @id @default(cuid())
  name        String
  description String?

  parishId String
  parish   Parish          @relation(fields: [parishId], references: [id], onDelete: Cascade)
  trackId  String?
  track    FormationTrack? @relation(fields: [trackId], references: [id], onDelete: SetNull)

  // Validade da formação em meses (renovação); null = não expira
  validityMonths  Int?
  // Pré-requisito: função/papel na pastoral que exige este curso (ex.: "Ministro")
  requiredForRole String?

  enrollments FormationEnrollment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([parishId])
  @@index([trackId])
  @@index([deletedAt])
  @@map("formation_courses")
