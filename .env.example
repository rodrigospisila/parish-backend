# Database
DATABASE_URL="postgresql://parish:parish123@localhost:5432/parish_db?schema=public"

# JWT — OBRIGATÓRIO: gere segredos fortes (mínimo 32 caracteres).
# A aplicação NÃO INICIA com valores vazios, curtos ou placeholders.
# Gerar com: openssl rand -hex 48
#   ou: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET=""
JWT_REFRESH_EXPIRES_IN="7d"

# Application
NODE_ENV="development"
PORT=3000
API_PREFIX="api/v1"

# CORS — origens explícitas separadas por vírgula.
# Sem esta variável, apenas localhost é permitido (dev). Em produção é OBRIGATÓRIA
# e não pode ser "*".
CORS_ORIGIN="http://localhost:5173,http://localhost:19006"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# SMS via Twilio (OTP e fallback de notificacoes de escala)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Email (SendGrid example)
EMAIL_FROM="noreply@parish.app"
SENDGRID_API_KEY=""

# Firebase Cloud Messaging
FCM_SERVER_KEY=""

# External APIs
CNBB_LITURGY_API_URL="https://liturgia.up.railway.app"

# Storage (AWS S3 example)
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

# Payment Gateways
MERCADO_PAGO_ACCESS_TOKEN=""
PAGSEGURO_TOKEN=""

