# Database
DATABASE_URL="postgresql://parish:parish123@localhost:5432/parish_db?schema=public"

# JWT — OBRIGATÓRIO: gere segredos fortes (mínimo 32 caracteres).
# A aplicação NÃO INICIA com valores vazios, curtos ou placeholders.
# Gerar com: openssl rand -hex 48
#   ou: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET=""
JWT_REFRESH_EXPIRES_IN="7d"

# Troca de senha obrigatória: "log" (padrão) só registra; "on" bloqueia as rotas até a troca
PASSWORD_CHANGE_ENFORCEMENT="log"

# Application
NODE_ENV="development"
PORT=3000
API_PREFIX="api/v1"

# CORS — origens explícitas separadas por vírgula.
# Sem esta variável, apenas localhost é permitido (dev). Em produção é OBRIGATÓRIA
# e não pode ser "*".
CORS_ORIGIN="http://localhost:5173,http://localhost:19006"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# SMS via Twilio (OTP e fallback de notificacoes de escala)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Email (SendGrid example)
EMAIL_FROM="noreply@parish.app"
SENDGRID_API_KEY=""

# Firebase Cloud Messaging
FCM_SERVER_KEY=""

# External APIs
CNBB_LITURGY_API_URL="https://liturgia.up.railway.app"

# Storage (AWS S3 example)
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

# Payment Gateways
MERCADO_PAGO_ACCESS_TOKEN=""
PAGSEGURO_TOKEN=""

# Mapa público do app (GET /api/v1/public/map/config) — provedor de tiles.
# Sem estas variáveis, usa o OpenStreetMap (https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png),
# que tem política de uso restrita: em produção com volume, troque por um provedor próprio.
# MAP_TILE_URL_DARK vazio = o app não tem tema escuro de mapa. MAP_TILE_SUBDOMAINS vazio = sem {s}.
MAP_TILE_URL=""
MAP_TILE_URL_DARK=""
MAP_TILE_ATTRIBUTION=""
MAP_TILE_MAX_ZOOM=""
MAP_TILE_SUBDOMAINS="abc"

# Rastreamento de erros (Sentry) — opcional. Sem SENTRY_DSN nada é enviado (o pacote nem carrega).
# Só vão erros 5xx/não tratados, com o código de rastreio (X-Request-Id); sem corpo, cookies,
# Authorization nem dado pessoal. Defina no ambiente real (Railway): é lido antes do .env.
SENTRY_DSN=""
# Ambiente exibido no Sentry (padrão: NODE_ENV). Ex.: "production", "staging"
SENTRY_ENVIRONMENT=""

# Suporte e canais públicos (Onda 1 — sem domínio próprio ainda: nada de inventar endereço).
# SUPPORT_EMAIL: caixa que recebe os avisos de lead novo (e-mail best-effort, além da notificação
# in-app ao SYSTEM_ADMIN), contato do webhook do Asaas quando o usuário não tem e-mail, e devolvido
# em GET /public/app-config. SUPPORT_WHATSAPP: número com DDI (ex.: 5542999990000), também no app-config.
SUPPORT_EMAIL=""
SUPPORT_WHATSAPP=""

# Versão do app (GET /api/v1/public/app-config). Formato curto 1.2 ou 1.2.3; vazio = sem bloqueio/aviso.
# APP_MIN_VERSION: abaixo dela o app mostra "Atualize o Parish" (bloqueante).
# APP_LATEST_VERSION: versão mais nova publicada (aviso não bloqueante). URLs só https.
APP_MIN_VERSION=""
APP_LATEST_VERSION=""
APP_IOS_URL=""
APP_ANDROID_URL=""

# Logs e operação (Onda 1, eng-qualidade-15). Sem LOG_FORMAT o formato atual do Nest não muda.
# LOG_FORMAT="json": uma linha JSON por log (time, level, context, message, requestId) e uma linha
#   por requisição (método, rota-padrão, status, ms, requestId — sem corpo, sem dado pessoal; /health fora).
# PRISMA_SLOW_QUERY_MS: consulta acima disso vira aviso (só o início do SQL, nunca os parâmetros).
#   Padrão 500; "0" desliga.
LOG_FORMAT=""
PRISMA_SLOW_QUERY_MS=""

# Push (outbox, eng-qualidade-02). O worker roda no próprio processo a cada 15 s (uma réplica por vez).
# PUSH_OUTBOX_WORKER="off" desliga o worker neste processo (os avisos ficam na fila até outro processo enviar).
# EXPO_ACCESS_TOKEN: só se a "segurança reforçada de push" estiver ligada no projeto Expo; vazio = como hoje.
PUSH_OUTBOX_WORKER=""
EXPO_ACCESS_TOKEN=""

# Faturamento da plataforma (Onda 1, C3) — conta Asaas DA EMPRESA, separada das contas das
# paróquias (dízimo). Sem PLATFORM_ASAAS_API_KEY e PLATFORM_ASAAS_WEBHOOK_TOKEN a contratação
# online responde 503 CHECKOUT_UNAVAILABLE e o resto (/billing/me, régua, testes) funciona.
# Webhook a cadastrar no Asaas: <API>/api/v1/platform/billing/webhook com este token.
PLATFORM_ASAAS_API_KEY=""
# sandbox (padrão) | production
PLATFORM_ASAAS_ENV="sandbox"
PLATFORM_ASAAS_WEBHOOK_TOKEN=""
# NFS-e automática da assinatura (POST /subscriptions/{id}/invoiceSettings). Liga só com o nome
# do serviço e o id OU o código municipal (ver "Notas fiscais > Serviços" no Asaas). Alíquotas em %
# (padrão 0) — definir com o contador. EFFECTIVE: ON_PAYMENT_CONFIRMATION (padrão) | ON_PAYMENT_DUE_DATE |
# BEFORE_PAYMENT_DUE_DATE | ON_DUE_DATE_MONTH | ON_NEXT_MONTH.
PLATFORM_NFSE_SERVICE_NAME=""
PLATFORM_NFSE_SERVICE_ID=""
PLATFORM_NFSE_SERVICE_CODE=""
PLATFORM_NFSE_OBSERVATIONS=""
PLATFORM_NFSE_EFFECTIVE=""
PLATFORM_NFSE_RETAIN_ISS="false"
PLATFORM_NFSE_ISS=""
PLATFORM_NFSE_COFINS=""
PLATFORM_NFSE_CSLL=""
PLATFORM_NFSE_INSS=""
PLATFORM_NFSE_IR=""
PLATFORM_NFSE_PIS=""
