# Variáveis do serviço da API no Railway (Postgres gerenciado).
# Só o essencial: o Parish hoje depende apenas de Postgres + JWT + CORS.
# (Twilio, SendGrid, AWS S3, Mercado Pago/PagSeguro estão no .env.example mas
#  ainda NÃO têm código — deixe de fora até serem implementados.)

# Banco: referencie a variável do Postgres gerenciado do Railway.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Segredos JWT — GERE FORTES (mín. 32 chars, sem "secret/change/example/default"):
#   openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Troca de senha obrigatória (conta criada/redefinida pela gestão): "log" (padrão)
# só registra; "on" bloqueia as rotas até a troca. Ligar "on" só depois que o
# app com a tela de troca de senha chegar aos aparelhos.
PASSWORD_CHANGE_ENFORCEMENT=log

# Aceite dos termos vigentes (conta sem aceite ou com versão antiga): "log"
# (padrão) só registra; "on" bloqueia as rotas (403 TERMS_ACCEPTANCE_REQUIRED)
# até o aceite. Ligar "on" só sob ordem, depois que app e painel com o aviso
# de aceite estiverem nos aparelhos.
TERMS_ENFORCEMENT=log

# Chave dos pseudônimos (HMAC) da auditoria LGPD — obrigatória em produção (sem
# ela o boot registra erro e a auditoria usa o JWT_SECRET). Para manter os
# pseudônimos já gravados, use o MESMO valor do JWT_SECRET atual; depois disso
# o JWT_SECRET pode ser trocado sem afetar a auditoria. Nunca troque esta chave.
AUDIT_PSEUDONYM_KEY=

NODE_ENV=production
API_PREFIX=api/v1

# CORS: a URL do dashboard web (Vercel), separadas por vírgula se houver mais de uma.
# O app mobile (nativo) não envia Origin, então não depende de CORS.
CORS_ORIGIN=https://SEU-WEB.vercel.app

TZ=America/Sao_Paulo

# PORT: NÃO definir — o Railway injeta e o main.ts lê process.env.PORT.

# Swagger (/api e /api-json): desligado com NODE_ENV=production. Só ligue
# (SWAGGER_ENABLED=true) por um tempo, para depurar — ele expõe o mapa da API.
# SWAGGER_ENABLED=true
# /health responde 503 se o SELECT 1 passar deste tempo (ms; padrão 3000).
# HEALTH_DB_TIMEOUT_MS=3000
